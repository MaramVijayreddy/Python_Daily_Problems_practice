class Solution:
    def convert(self, s: str, numRows: int) -> str:
        if len(s)==1 or numRows == 1 or numRows>len(s):
            return s
        if len(s)<1:
            return 0
        row=0
        direction=1
        rows=[""]*numRows
        for ch in s:
            rows[row]+=ch
            if row==0:
                direction=1
            elif row==numRows-1:
                direction= -1
            row+=direction
        return "".join(rows)
            

